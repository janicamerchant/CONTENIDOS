{
  "name": "estudio-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "inventory": "tsx scripts/migrate.ts",
    "migrate:apply": "tsx scripts/migrate.ts --apply",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "backup": "tsx scripts/backup.ts",
    "check": "npm run typecheck && npm test",
    "test:integration": "tsx scripts/integration.ts",
    "migrate:verify": "tsx scripts/verify-import.ts",
    "build": "node scripts/build.mjs",
    "dev": "tsx scripts/dev.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32",
    "@supabase/supabase-js": "2.117.2",
    "@vercel/functions": "3.9.9",
    "tus-js-client": "4.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
